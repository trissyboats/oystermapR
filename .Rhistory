devtools::install("/Users/home/Documents/Claude/Projects/oystermapR")
library(oystermapR)
set.seed(42)
n <- 120
result <- data.frame(
lat              = runif(n, 55.5, 56.5),
lon              = runif(n, -5.5, -4.5),
suitability      = pmin(1, pmax(0, rnorm(n, mean = 0.55, sd = 0.22))),
suitability_class = NA_character_,
data_completeness = runif(n, 0.4, 1.0),
# per-variable mean scores (the report plots these)
score_temperature        = runif(n, 0.3, 1),
score_salinity           = runif(n, 0.5, 1),
score_depth              = runif(n, 0.1, 1),
score_turbidity          = runif(n, 0.2, 0.9),
score_dissolved_oxygen   = runif(n, 0.4, 1),
score_ph                 = runif(n, 0.6, 1),
score_chlorophyll_a      = runif(n, 0.3, 0.95),
# intertidal flag (added by add_intertidal_flag)
intertidal_zone          = sample(c("subtidal","intertidal","supratidal"),
n, replace = TRUE, prob = c(0.7, 0.25, 0.05)),
stringsAsFactors = FALSE
)
result$suitability_class <- cut(
result$suitability,
breaks = c(-Inf, 0.3, 0.5, 0.7, Inf),
labels = c("Unsuitable","Low","Moderate","High"),
right  = TRUE
)
comp <- result[, c("lat","lon","suitability","suitability_class")]
names(comp)[3:4] <- c("suit_ostrea_edulis", "class_ostrea_edulis")
comp$suit_magallana_gigas  <- pmin(1, pmax(0, rnorm(n, 0.65, 0.18)))
comp$class_magallana_gigas <- cut(
comp$suit_magallana_gigas,
breaks = c(-Inf, 0.3, 0.5, 0.7, Inf),
labels = c("Unsuitable","Low","Moderate","High")
)
penalty <- ifelse(comp$class_magallana_gigas == "High",     0.80,
ifelse(comp$class_magallana_gigas == "Moderate", 0.92, 1.0))
comp$suit_ostrea_edulis_competition_adj <- comp$suit_ostrea_edulis * penalty
records <- data.frame(
lat      = c(runif(40, 55.5, 56.5), runif(20, 55.5, 56.5)),
lon      = c(runif(40, -5.5, -4.5), runif(20, -5.5, -4.5)),
presence = c(rep(1L, 40), rep(0L, 20))
)
val <- validate_against_records(result, records, presence_col = "presence")
out <- generate_report(
result     = result,
output     = "test_report.html",
title      = "Test — Kames Bay Oyster Habitat Assessment",
author     = "oystermapR smoke-test",
species    = "ostrea_edulis",
top_n      = 5,
validation = val,
comparison = comp,
open       = TRUE       # set FALSE to skip auto-opening
)
message("Report written to: ", out)
